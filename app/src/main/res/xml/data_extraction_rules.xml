<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde cloud ni transfert d'appareil : secrets, liens de flux et catalogue restent locaux.
     Une exportation volontaire des préférences (sans identifiants) est prévue plus tard. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
